# Klucz API dostawcy modelu (domyślnie Anthropic).
ANTHROPIC_API_KEY=

# Model domyślny dla wszystkich agentów (format provider:model, patrz init_chat_model).
AGENT_MODEL=anthropic:claude-haiku-5-5
# Opcjonalnie osobne modele dla agentów:
# AGENT_ORCHESTRATOR_MODEL=anthropic:claude-sonnet-5-5
# AGENT_FINANCE_MODEL=
# AGENT_RAG_MODEL=

# Foldery z danymi (domyślnie ./data/finance i ./data/docs).
# AGENT_FINANCE_DIR=/sciezka/do/excelow
# AGENT_DOCS_DIR=/sciezka/do/dokumentow

# Opcjonalne embeddingi do RAG i pamięci semantycznej (domyślnie BM25, bez kosztów).
# AGENT_EMBEDDINGS_MODEL=openai:text-embedding-3-small

# Śledzenie w LangSmith (opcjonalnie).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
